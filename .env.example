# Apple iCloud Credentials
# ========================
#
# Setup:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your values below
#   3. NEVER commit .env to Git (it's in .gitignore)
#
# Generate an app-specific password:
#   1. Go to https://appleid.apple.com
#   2. Sign in with your Apple ID
#   3. Navigate to: Sign-In and Security → App-Specific Passwords
#   4. Click "+" to generate a new password
#   5. Name it "Apple MCP Server" (or anything you like)
#   6. Copy the generated password (format: xxxx-xxxx-xxxx-xxxx)
#
# Requirements:
#   - Two-factor authentication MUST be enabled on your Apple ID
#   - Use your full iCloud email (e.g., you@icloud.com or you@me.com)
#   - Use the app-specific password, NOT your regular Apple ID password

ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# Optional: override the host port when running with Docker Compose (default: 8000)
# MCP_PORT=8000
